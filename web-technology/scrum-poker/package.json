{
  "name": "scrum-poker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently --names server,client --prefix-colors blue,green \"pnpm --filter @scrum-poker/server dev\" \"pnpm --filter @scrum-poker/client dev\"",
    "build": "pnpm --recursive build",
    "typecheck": "pnpm --recursive typecheck && tsc -p e2e",
    "lint": "eslint . --max-warnings 0",
    "test": "pnpm --recursive test",
    "test:e2e": "playwright test",
    "docs:pdf": "./scripts/build-pdf.sh",
    "docs:html": "./scripts/build-pdf.sh html",
    "docs:docx": "./scripts/build-docx.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@scrum-poker/shared": "workspace:*",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
